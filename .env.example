# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file with real credentials.

# MySQL connection string.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/medical_camp_db

# CORS: comma-separated list of origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173
