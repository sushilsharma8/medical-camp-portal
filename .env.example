# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file with real credentials.
#
# On Vercel, set DATABASE_URL in the project environment (not in a committed
# file). The host must be reachable from Vercel — localhost is local dev only.

# MySQL connection string.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/medical_camp_db

# CORS: comma-separated list of origins allowed to call the API directly.
# Not required when the browser uses same-origin /api (Vercel rewrites, or the
# Vite dev proxy). Set it when VITE_API_URL points at a different host, for
# example the Vite dev server calling uvicorn without the proxy:
# FRONTEND_ORIGIN=http://localhost:5173
